---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { ARCHIVE_TYPES } from '../../consts';

export async function getStaticPaths() {
  return ARCHIVE_TYPES.map((t) => ({ params: { type: t.slug } }));
}

const { type } = Astro.params;
const meta = ARCHIVE_TYPES.find((t) => t.slug === type)!;
const base = import.meta.env.BASE_URL;

const items = (await getCollection('archive'))
  .filter((i) => i.data.type === type)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={meta.en} current="/archive/">
  <div class="narrow" style="padding-top:26px">
    <div style="font-size:13px;margin-bottom:10px">
      <a href={`${base}archive/`} style="color:var(--muted)">← Archive</a>
    </div>
    <h1 style="font-family:var(--serif);font-size:34px;font-weight:400;letter-spacing:.1em;margin:0">{meta.en}</h1>
    <div style="font-size:13px;color:var(--muted);margin:6px 0 20px">{meta.cn}共 {items.length} 条。</div>
    {items.length === 0 ? (
      <p style="color:var(--muted)">还没有收录。</p>
    ) : (
      items.map((i) => (
        <div class="architem" style="padding:14px 0;border-bottom:1px solid var(--border)">
          <div class="t" style="font-size:17px">{i.data.title}</div>
          <div class="n" style="font-size:13.5px;color:var(--muted);margin-top:6px;line-height:1.8">
            <FormattedDate date={i.data.date} />
            {i.data.description && <div style="margin-top:4px">{i.data.description}</div>}
            {i.data.url && (
              <div style="margin-top:4px"><a href={i.data.url} target="_blank" rel="noopener" style="border-bottom:1px solid var(--border)">链接 →</a></div>
            )}
          </div>
        </div>
      ))
    )}
  </div>
</Base>
