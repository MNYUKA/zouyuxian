---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const sets = (await getCollection('photos')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const slugOf = (id: string) => id.replace(/\.md$/, '');
// 从正文里取第一张图作封面，并统计照片数
const coverOf = (body: string) => body.match(/!\[[^\]]*\]\(([^)]+)\)/)?.[1];
const countOf = (body: string) => (body.match(/!\[[^\]]*\]\(/g) ?? []).length;
---

<Base title="Photos" current="/photos/">
  <div class="wrap" style="padding-top:26px">
    <h1 style="font-family:var(--serif);font-size:34px;font-weight:400;letter-spacing:.06em;margin:0">Photos</h1>
    <div style="font-size:13px;color:var(--muted);margin:6px 0 26px">
      摄影。一组照片算一条，按拍摄日期倒序。{sets.length > 0 ? `共 ${sets.length} 组。` : '还没有发布照片。'}
    </div>
    <div class="photogrid">
      {sets.map((s) => (
        <a class="photocard" href={`${base}photos/${slugOf(s.id)}/`}>
          {coverOf(s.body) && (
            <span class="photothumb"><img src={coverOf(s.body)} alt={s.data.title} loading="lazy" /></span>
          )}
          <span class="phototitle">{s.data.title}</span>
          <span class="photometa"><FormattedDate date={s.data.pubDate} />{countOf(s.body) > 0 && ` · ${countOf(s.body)} 张`}</span>
          {s.data.description && <span class="photodesc">{s.data.description}</span>}
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .photogrid { display:grid; grid-template-columns:repeat(2, 1fr); gap:34px 26px; }
  @media (max-width:640px) { .photogrid { grid-template-columns:1fr; } }
  .photocard { display:block; text-decoration:none; color:inherit; }
  .photothumb { display:block; aspect-ratio:4/3; overflow:hidden; background:#F1EFE9; }
  .photothumb img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .35s ease; }
  .photocard:hover .photothumb img { transform:scale(1.025); }
  .phototitle { display:block; font-family:var(--serif); font-size:19px; margin:12px 0 4px; }
  .photocard:hover .phototitle { text-decoration:underline; text-underline-offset:4px; }
  .photometa { display:block; font-size:12.5px; color:var(--muted); letter-spacing:.05em; }
  .photodesc { display:block; font-size:13.5px; color:var(--muted); line-height:1.8; margin-top:5px; }
</style>
