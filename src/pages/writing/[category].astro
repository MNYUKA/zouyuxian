---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { WRITING_CATEGORIES, FORMAT_CN } from '../../consts';

export async function getStaticPaths() {
  return WRITING_CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const meta = WRITING_CATEGORIES.find((c) => c.slug === category)!;
const base = import.meta.env.BASE_URL;

const articles = (await getCollection('articles'))
  .filter((a) => a.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const slugOf = (id: string) => id.replace(/\.md$/, '');
---

<Base title={meta.en} current="/writing/">
  <div class="narrow" style="padding-top:26px">
    <div style="font-size:13px;margin-bottom:10px">
      <a href={`${base}writing/`} style="color:var(--muted)">← Writing</a>
    </div>
    <h1 style="font-family:var(--serif);font-size:34px;font-weight:400;letter-spacing:.1em;margin:0">{meta.en}</h1>
    <div style="font-size:13.5px;color:var(--muted);margin:6px 0 20px">
      {meta.cn}共 {articles.length} 篇，按发布日期倒序。
    </div>
    {articles.length === 0 ? (
      <p style="color:var(--muted)">这个主题还没有文章。</p>
    ) : (
      articles.map((a) => (
        <div class="postitem">
          <a href={`${base}writing/${slugOf(a.id)}/`}><h3>{a.data.title}</h3></a>
          <div class="meta">
            <FormattedDate date={a.data.pubDate} />
            {a.data.format && ` · ${FORMAT_CN[a.data.format] ?? a.data.format}`}
          </div>
          {a.data.description && <p class="desc">{a.data.description}</p>}
        </div>
      ))
    )}
  </div>
</Base>
