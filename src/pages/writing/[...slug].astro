---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagRow from '../../components/TagRow.astro';
import { getCollection, render } from 'astro:content';
import { WRITING_CATEGORIES, FORMAT_CN, LANG_CN } from '../../consts';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const catEn = WRITING_CATEGORIES.find((c) => c.slug === entry.data.category)?.en ?? entry.data.category;
---

<Base title={entry.data.title} description={entry.data.description} current="/writing/">
  <div class="narrow article" data-format={entry.data.format ?? ''} style="padding-top:26px">
    <div style="font-size:13px;margin-bottom:10px;font-family:var(--sans)">
      <a href={`${base}writing/`} style="color:var(--muted)">← Writing</a>
    </div>
    <h1>{entry.data.title}</h1>
    <div class="meta">
      <FormattedDate date={entry.data.pubDate} />
      {` · ${catEn}`}
      {entry.data.format && ` · ${FORMAT_CN[entry.data.format] ?? entry.data.format}`}
      {entry.data.language && entry.data.language !== 'zh' && ` · ${LANG_CN[entry.data.language] ?? entry.data.language}`}
      {entry.data.updatedDate && (
        <span>{` · 更新于 `}<FormattedDate date={entry.data.updatedDate} /></span>
      )}
      <TagRow tags={entry.data.tags} />
    </div>
    <div class="body">
      <Content />
    </div>
  </div>
</Base>
