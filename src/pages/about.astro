---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

// About 正文来自 Notion（Section=About 的一行，同步到 content-gen/about/index.md）
// 没有已发布的 About 行时，只显示问候语，不开天窗。
const aboutEntries = await getCollection('about');
let NotionBody = null;
if (aboutEntries.length > 0) {
  const rendered = await render(aboutEntries[0]);
  NotionBody = rendered.Content;
}
---

<Base title="About" current="/about/">
  <div class="narrow" style="padding-top:26px">
    <div style="font-size:12px;letter-spacing:.18em;color:var(--muted);margin-bottom:14px">ABOUT / YUKA</div>
    <h1 style="font-family:var(--serif);font-size:34px;font-weight:400;letter-spacing:.04em;margin:0">你好，我是 Yuka。</h1>
    <div class="bio" style="margin-top:26px">
      {NotionBody && <NotionBody />}
      <p class="about-contact">想对我说点什么？<button type="button" class="contact-open">Contact Me</button></p>
    </div>
  </div>
  <style>
    .bio p { font-family: var(--serif); font-size: 17px; line-height: 1.95; margin: 0 0 1.2em; }
  </style>
</Base>
